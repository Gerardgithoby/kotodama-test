<!DOCTYPE html>
<html lang="mg">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KOTODAMA - Fitsapana Asa Sahaza (Test de travail approprié)</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      margin: 0;
      padding: 15px;
      color: #222;
    }
    .container {
      max-width: 680px;
      margin: 20px auto;
      background: white;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 3px 15px rgba(0, 0, 0, 0.1);
    }
    h1 {
      color: #b60000;
      text-align: center;
      font-size: 26px;
      margin-bottom: 5px;
    }
    .jiko-rikai {
      text-align: center;
      font-size: 16px;
      font-weight: bold;
      color: #b60000;
      margin-top: 0;
      margin-bottom: 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .subtitle {
      text-align: center;
      color: #555;
    }
    .question {
      padding: 18px 0;
      border-bottom: 1px solid #ddd;
    }
    .question h3 {
      font-size: 17px;
    }
    .choice {
      display: block;
      padding: 12px;
      margin: 8px 0;
      background: #f7f7f7;
      border: 1px solid #ddd;
      border-radius: 8px;
      cursor: pointer;
    }
    .choice:has(input:checked) {
      background: #ffeded;
      border-color: #c00;
    }
    input {
      margin-right: 9px;
    }
    button {
      background: #b60000;
      color: white;
      border: 0;
      padding: 15px;
      width: 100%;
      border-radius: 9px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 20px;
    }
    button:hover {
      background: #850000;
    }
    #result {
      display: none;
      background: #f6f6f6;
      border-left: 5px solid #b60000;
      margin-top: 25px;
      padding: 20px;
      border-radius: 7px;
    }
    .note {
      font-size: 13px;
      color: #666;
      margin-top: 20px;
      text-align: center;
    }
    .footer-credits {
      margin-top: 15px;
      text-align: center;
      font-size: 12px;
      color: #888;
      font-weight: bold;
    }
  </style>
</head>
<body>

<div class="container">
  <h1>KOTODAMA</h1>
  <div class="jiko-rikai">test Jiko Rikai</div>
  <p class="subtitle"><strong>FITSAPANA: Inona ny karazana asa mety aminao? (TEST : Quel type d'emploi vous convient le mieux ?)</strong></p>
  <p>
    Valio araka izay tianao sy tsapanao ireo fanontaniana 7 ireo. Tsy misy valiny diso na marina. 
    (Répondez à ces 7 questions comme vous le souhaitez. Il n'y a pas de bonnes ou de mauvaises réponses.)
  </p>

  <form id="quiz-form"></form>

  <button type="button" onclick="calculate()">
    JEREO NY VALINY FITSAPANA (VOIR LES RÉSULTATS DU TEST)
  </button>

  <div id="result" aria-live="polite"></div>

  <p class="note">
    Fitsapana santionany maimaim-poana ho an'ny momba ny asa. (Test d'essai gratuit. Il s'agit d'une évaluation professionnelle.)
  </p>
  <div class="footer-credits">Conception Jcm 2026</div>
</div>

<script>
const questions = [
  {
    q: "1. Inona no asa tena mahafinaritra anao? (Quel est votre travail préféré ?)",
    a: [
      ["Manamboatra na mamorona zavatra (Fabriquer ou créer des choses)", "A"],
      ["Mamakafaka olana sarotra (Analyser des problèmes complexes)", "B"],
      ["Mamorona sary na hevitra vaovao (Créer de nouvelles idées ou images)", "C"],
      ["Manampy sy mampianatra olona (Aider et former les gens)", "D"],
      ["Mandamina sy mitantana asa (Organiser et gérer le travail)", "E"]
    ]
  },
  {
    q: "2. Raha misy olana, inona no ataonao voalohany? (Face à un problème, quelle est votre première action ?)",
    a: [
      ["Mitady fomba azo ampiharina (Trouver des solutions pratiques)", "A"],
      ["Manangona vaovao sy mandinika (Recueillir et analyser des informations)", "B"],
      ["Mitady vahaolana vaovao (Trouver de nouvelles solutions)", "C"],
      ["Mihaino ny hevitry ny olona (Écouter les idées des autres)", "D"],
      ["Mametraka drafitra sy mandray fanapahan-kevitra (Élaborer des plans et prendre des décisions)", "E"]
    ]
  },
  {
    q: "3. Aiza no tianao hiasana? (Où aimeriez-vous travailler ?)",
    a: [
      ["Toerana ahafahana manao asa tanana (Un endroit où je peux faire du travail manuel)", "A"],
      ["Laboratoara na toeram-pikarohana (Bureau ou centre de recherche)", "B"],
      ["Studio na toerana famoronana (Atelier ou espace créatif)", "C"],
      ["Sekoly na toeram-panompoana olona (École ou centre de services sociaux)", "D"],
      ["Orinasa na birao fitantanana (Bureau commercial ou administratif)", "E"]
    ]
  },
  {
    q: "4. Inona no tena fahaizanao tianao hampivelarina? (Quelle est la principale compétence que vous souhaitez développer ?)",
    a: [
      ["Fahaizana teknika (Compétences techniques)", "A"],
      ["Famakafakana sy fikarohana (Analyse et recherche)", "B"],
      ["Fahaizana mamorona (Compétences créatives)", "C"],
      ["Fifandraisana amin'ny olona (Compétences interpersonnelles)", "D"],
      ["Fitarihana sy fandaminana (Leadership et organisation)", "E"]
    ]
  },
  {
    q: "5. Raha omena tetikasa ianao, inona no safidinao? (Si vous deviez choisir un projet, lequel choisiriez-vous ?)",
    a: [
      ["Manamboatra ny fitaovana ilaina (Fabriquer le matériel nécessaire)", "A"],
      ["Mandini-tena sy manao kajy (Réfléchir et calculer)", "B"],
      ["Mamorona ny endrika sy hevitra (Concevoir le design et les idées)", "C"],
      ["Manampy ny mpikambana rehetra (Aider tous les membres)", "D"],
      ["Mitantana ny tetikasa (Gérer le projet)", "E"]
    ]
  },
  {
    q: "6. Inona no zavatra mampirehareha anao? (De quoi êtes-vous le plus fier ?)",
    a: [
      ["Zavatra vitako tamin'ny tanako (Ce que j'ai fait de mes mains)", "A"],
      ["Olana sarotra voavahako (Les problèmes complexes que j'ai résolus)", "B"],
      ["Hevitra vaovao noforoniko (Les nouvelles idées que j'ai créées)", "C"],
      ["Olona tafita noho ny fanampiako (Les personnes que j'ai aidées à réussir)", "D"],
      ["Tanjona tratran'ny ekipa tarihiko (Les objectifs atteints par mon équipe)", "E"]
    ]
  },
  {
    q: "7. Inona no asa hahafaly anao kokoa? (Quel métier vous rendrait le plus heureux ?)",
    a: [
      ["Teknisiana na mpanao asa fampiharana (Technicien ou praticien)", "A"],
      ["Mpikaroka na mpandinika (Chercheur ou analyste)", "B"],
      ["Mpanakanto na mpamorona (Artiste ou designer)", "C"],
      ["Mpampianatra na mpanampy olona (Enseignant ou assistant)", "D"],
      ["Mpandraharaha na mpitantana (Entrepreneur ou manager)", "E"]
    ]
  }
];

const profiles = {
  A: {
    name: "ASA TEKNIKA SY FAMPIHARANA (TRAVAIL TECHNIQUE ET D'APPLICATION)",
    desc: "Mety hahafinaritra anao ny asa ahitana vokatra mivaingana, fitaovana ary fampiharana. (Vous pourriez apprécier un travail impliquant des produits, des outils et des applications concrets.)"
  },
  B: {
    name: "FIKAROHANA SY FANDINIHANA (RECHERCHE ET INVESTIGATION)",
    desc: "Mety hahafinaritra anao ny mamakafaka vaovao, mamaha olana ary mikaroka. (Vous pourriez apprécier l'analyse d'informations, la résolution de problèmes et l'exploration.)"
  },
  C: {
    name: "FAMORONANA SY ZAVA-KANTO (CRÉATION ET ART)",
    desc: "Mety hahafinaritra anao ny mamorona hevitra, endrika ary fomba vaovao. (Vous pourriez apprécier la création de nouvelles idées, formes et méthodes.)"
  },
  D: {
    name: "FANAMPIANA SY FIFANDRAISANA (AIDE ET COMMUNICATION)",
    desc: "Mety hahafinaritra anao ny mampianatra, mihaino ary manampy olona. (Vous pourriez apprécier l'enseignement, l'écoute et l'aide aux autres.)"
  },
  E: {
    name: "FITANTANANA SY FITARIHANA (GESTION ET LEADERSHIP)",
    desc: "Mety hahafinaritra anao ny mandamina, mitarika ekipa ary mampandroso tetikasa. (Vous pourriez apprécier l'organisation, la direction d'équipes et le développement de projets.)"
  }
};

const quizContainer = document.getElementById("quiz-form");

questions.forEach((item, i) => {
  const div = document.createElement("div");
  div.className = "question";

  const title = document.createElement("h3");
  title.textContent = item.q;
  div.appendChild(title);

  item.a.forEach(([label, value]) => {
    const option = document.createElement("label");
    option.className = "choice";

    const radio = document.createElement("input");
    radio.type = "radio";
    radio.name = "q" + i;
    radio.value = value;

    option.appendChild(radio);
    option.appendChild(document.createTextNode(label));
    div.appendChild(option);
  });

  quizContainer.appendChild(div);
});

function calculate() {
  const scores = { A: 0, B: 0, C: 0, D: 0, E: 0 };

  for (let i = 0; i < questions.length; i++) {
    const answer = document.querySelector('input[name="q' + i + '"]:checked');

    if (!answer) {
      alert("Valio daholo aloha ireo fanontaniana 7. (Veuillez répondre à toutes les 7 questions.)");
      return;
    }
    scores[answer.value]++;
  }

  const highest = Math.max(...Object.values(scores));
  const winners = Object.keys(scores).filter(key => scores[key] === highest);

  const result = document.getElementById("result");
  result.replaceChildren();

  function add(tag, text) {
    const el = document.createElement(tag);
    el.textContent = text;
    result.appendChild(el);
  }

  add("h2", "Vokatry ny fitsapanao (Résultats de votre test)");

  winners.forEach(key => {
    add("h3", profiles[key].name);
    add("p", profiles[key].desc);
  });

  if (winners.length > 1) {
    add("p", "Misy fironana maromaro mitovy hery aminao. (Vous avez plusieurs tendances de même force.)");
  }

  add("p", "Ity dia santionany fotsiny. Tsy ampy hamaritana ny asa sahaza anao ny fanontaniana 7. (Ceci n'est qu'un échantillon. 7 questions ne suffisent pas pour déterminer le travail qui vous convient.)");
  add("h3", "Te hahafantatra bebe kokoa? (En savoir plus ?)");
  add("p", "Ao amin'ny Séminaire KOTODAMA no handinihana lalindalina kokoa ny talentanao, ny zavatra mahaliana anao ary ny safidy momba ny asa, amin'ny alalan'ny fitsapana feno misy fanontaniana 25. (C'est lors du Séminaire KOTODAMA que nous analyserons plus en détail vos talents, vos centres d'intérêt et vos choix de carrière, grâce à un test complet de 25 questions.)");

  result.style.display = "block";
  result.scrollIntoView({ behavior: "smooth" });
}
</script>
</body>
</html>